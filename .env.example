DATABASE_URL="postgresql://faith:faith@localhost:5432/faith_project?schema=public"
NODE_ENV="development"
# Deployment identity: use preview only on the isolated testing backend.
# Hosted preview retains NODE_ENV=production for normal runtime security.
# Production must use APP_ENV=production. Local development requires a
# development/test NODE_ENV; an absent APP_ENV supports those local workflows.
APP_ENV="development"
# Master opt-in for demo accounts/invites, training tools, Swagger and seeds.
# APP_ENV=production/unknown always disables features; absent APP_ENV is
# disabled when NODE_ENV is production, missing or unknown.
# The Expo app independently requires EXPO_PUBLIC_DEV_FEATURES_ENABLED=true.
DEV_FEATURES_ENABLED="false"
# Additional seed opt-in; requires a loopback PostgreSQL *_dev/*_test database
# or the established local faith_project database. Never use a deployed database.
ALLOW_DEMO_SEED="false"
# One-off opt-in for npm run preview:fixtures on an isolated APP_ENV=preview.
# Do not persist true in the host config; it only prepares reserved demo users.
ALLOW_PREVIEW_FIXTURES="false"
JWT_SECRET="replace-me"
JWT_EXPIRES_IN="7d"
# Transactional recovery/verification email. Never commit real credentials.
# Use a company-approved SMTP service and verified sender; STARTTLS is required.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SECURITY_EMAIL_FROM=""
# Enable only after configuring APNs/FCM credentials for the EAS project,
# deploying the migration and verifying delivery on both native builds.
PUSH_NOTIFICATIONS_ENABLED="false"
# Enable enhanced push security in Expo and supply its server-only access token.
EXPO_ACCESS_TOKEN=""
PORT=3002
# Set NODE_ENV=production, APP_ENV=production, a non-default JWT_SECRET of at least 32 characters,
# and the exact deployed web origin(s) in the production host configuration.
CORS_ORIGIN="http://localhost:8081,http://localhost:19006"
# Set this true only when the host sits behind a trusted reverse proxy such as
# Heroku. It lets HTTP rate limits use the real client IP address.
TRUST_PROXY="false"
# Swagger requires the development master opt-in and this feature flag.
ENABLE_SWAGGER="false"
# Comma-separated business policy terms that must not be sent in private chat.
# This value must not be blank in production.
MESSAGE_BLOCKED_TERMS=""
# Required in production: HTTPS webhook to a monitored Hercules operations
# queue. Do not put message bodies or account emails in the webhook payload.
OPERATIONS_WEBHOOK_URL=""

# Jotform dealer-registration integration. Leave disabled until the database
# migration is deployed and the read-only API key + webhook secret are set.
JOTFORM_INTEGRATION_ENABLED="false"
JOTFORM_FORM_ID="252405795315055"
JOTFORM_API_KEY=""
# Generate at least 32 URL-safe ASCII characters (letters, digits, _ or -).
# Standard Jotform webhooks use it as an HTTP Basic password. Never log or
# commit it.
JOTFORM_WEBHOOK_SECRET=""
# Optional previous value for zero-downtime secret rotation.
JOTFORM_WEBHOOK_PREVIOUS_SECRET=""
# Choose the host matching the Jotform account region: api, eu-api, or hipaa-api.
JOTFORM_API_BASE_URL="https://api.jotform.com"
# Current form question IDs. Labels may change; integration mapping uses IDs.
JOTFORM_EMAIL_QID="13"
JOTFORM_COMPANY_QID="14"
JOTFORM_NAME_QID="4"
# Leave blank until the form has a confirmed dealer-number field.
JOTFORM_DEALER_NUMBER_QID=""
# Reliability controls (defaults shown).
JOTFORM_REQUEST_TIMEOUT_MS="10000"
JOTFORM_PROCESSING_BATCH_SIZE="25"
JOTFORM_MAX_PROCESSING_ATTEMPTS="8"
JOTFORM_RETRY_BASE_DELAY_MS="30000"
JOTFORM_RETRY_MAX_DELAY_MS="3600000"
JOTFORM_PROCESSING_LEASE_SECONDS="120"
JOTFORM_RECONCILIATION_PAGE_SIZE="100"
JOTFORM_RECONCILIATION_MAX_PAGES="10"
JOTFORM_RECONCILIATION_LOOKBACK_MINUTES="1440"
JOTFORM_API_RATE_LIMIT_RESERVE="100"
# Required when enabling the integration. This is the deliberate first-sync
# boundary in Jotform's YYYY-MM-DD HH:MM:SS format. Copy the earliest intended
# record's updated_at from this API origin and subtract one vendor-clock second.
JOTFORM_RECONCILIATION_START_AT=""
# Used only by the one-time idempotent webhook-registration command. Use a
# separate Full Access key here; the runtime key above should remain Read Access.
JOTFORM_WEBHOOK_ADMIN_API_KEY=""
# HTTPS origin only: no path, query, credentials, or fragment.
JOTFORM_WEBHOOK_PUBLIC_BASE_URL=""

# Synchrony financing: populate only with Nicole/team-approved destination and
# display copy. Both are required; blank/unsupported values show unavailable.
# Use a public HTTPS URL supported by the existing in-app content viewer.
# Do not use conversational rates, draft terms, or an inferred home page.
SYNCHRONY_FINANCING_URL=""
SYNCHRONY_FINANCING_DESCRIPTION=""

# Proposed onboarding policy: enable only after approving manager assignment,
# feature access matrix and the source/owner of initial-training verification.
# Reserved registration-copy recipients: comma-separated email addresses.
# Leave blank until approved recipients and delivery routing are supplied.
# This setting DOES NOT send mail or change existing Jotform/Zapier routing.
# It does not assign managers or authorize training verifiers.
JOTFORM_REGISTRATION_NOTIFICATION_EMAILS=""
JOTFORM_ONBOARDING_ENABLED="false"
# Explicit active SALES_MANAGER user ID. Missing assignment queues review;
# never picks the first manager or silently grants an existing account access.
JOTFORM_ONBOARDING_MANAGER_ID=""
# Approved verifier IDs; each can verify only their own assigned dealers.
# Blank disables completion writes. Approval of the authoritative source is
# an operational prerequisite; a registration/enrollment is never completion.
ONBOARDING_VERIFIER_MANAGER_IDS=""

# Requires DEV_FEATURES_ENABLED=true and a permitted deployment.
# Local development/test requires a loopback *_dev/*_test PostgreSQL database.
# APP_ENV=preview also permits the isolated hosted test database, but only for
# authenticated synthetic *@hercules.local dealers. Real accounts are rejected.
# Requires frontend EXPO_PUBLIC_DEV_FEATURES_ENABLED=true,
# EXPO_PUBLIC_DEV_TRAINING_TOGGLE=true and a development or preview app environment.
# Never enables in production; genuine verification records remain protected.
DEV_TRAINING_TOGGLE_ENABLED="false"
