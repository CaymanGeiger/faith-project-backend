generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PROSPECT
  SALES_MANAGER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CertificationStatus {
  ONBOARDING
  CLASS_SIGNUP_PENDING
  IN_PROGRESS
  CERTIFIED
}

enum InviteStatusRole {
  PROSPECT
  SALES_MANAGER
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum ClassEnrollmentStatus {
  ENROLLED
  COMPLETED
  CANCELED
}

enum EquipmentRegistrationStatus {
  SUBMITTED
  APPROVED
  NEEDS_REVIEW
}

enum ResourceType {
  CATALOG
  REGISTRATION_OVERVIEW
  DOCUMENT
  APP
}

enum TodoItemType {
  CLASS_SIGNUP
  EQUIPMENT_REGISTRATION
  MARKETING_CONSULTATION
  JB_WARRANTIES
  RESOURCE_REVIEW
}

enum TodoItemStatus {
  OPEN
  COMPLETED
}

enum BenefitType {
  DISCOUNT
  WARRANTY
  LEAD_GENERATION
}

enum MarketingSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  COMPLETED
  FAILED
}

enum LeadRecordStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CERTIFIED
  LOST
}

enum ConversationType {
  PROSPECT_MANAGER
}

enum AccountDeletionRequestSource {
  IN_APP
  WEB
}

enum AccountDeletionRequestStatus {
  PENDING_VERIFICATION
  PENDING_REASSIGNMENT
  COMPLETED
}

enum MessageReportStatus {
  OPEN
  RESOLVED
}

enum JotformSyncStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  PROCESSED
  DEAD_LETTER
  REJECTED
}

enum JotformSyncSource {
  WEBHOOK
  RECONCILIATION
  MANUAL_REPLAY
}

model User {
  id                      String     @id @default(cuid())
  email                   String     @unique
  passwordHash            String
  sessionVersion          Int        @default(0)
  firstName               String
  lastName                String
  phone                   String?
  role                    UserRole
  status                  UserStatus @default(ACTIVE)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  lastLoginAt             DateTime?
  onboardingRequired      Boolean    @default(true)
  activationSubmissionId  String?    @unique
  initialTrainingVerifiedAt DateTime?
  termsAcceptedAt         DateTime?
  termsVersion            String?
  privacyPolicyAcceptedAt DateTime?

  prospectProfile     ProspectProfile?          @relation("ProspectUser")
  salesManagerProfile SalesManagerProfile?      @relation("SalesManagerUser")
  assignedProspects   ProspectProfile[]         @relation("AssignedSalesManager")
  classEnrollments    ClassEnrollment[]
  equipmentRecords    EquipmentRegistration[]
  todoItems           TodoItem[]
  marketingConsults   MarketingConsultation[]
  prospectLeadRecords LeadRecord[]              @relation("LeadProspect")
  managedLeadRecords  LeadRecord[]              @relation("LeadManager")
  participants        ConversationParticipant[]
  sentMessages        Message[]
  filedMessageReports MessageReport[]           @relation("MessageReporter")
  blocksCreated       UserBlock[]               @relation("UserBlocker")
  blocksReceived      UserBlock[]               @relation("BlockedUser")
  securityChallenges SecurityChallenge[]
  emailHistory AccountEmailHistory[]
  pushDevices PushDevice[]
  ownedSubmissions JotformSubmission[]
  initialTrainingVerification InitialTrainingVerification? @relation("TrainingProspect")
  recordedTrainingVerifications InitialTrainingVerification[] @relation("TrainingVerifier")
}

model SecurityChallenge {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  codeHash String
  deliveryCode String?
  mailAttempts Int @default(0)
  mailNextAttemptAt DateTime @default(now())
  mailLeaseUntil DateTime?
  targetEmail String
  sessionVersion Int
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([userId, purpose])
}

model AccountEmailHistory {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String
  createdAt DateTime @default(now())
  @@unique([userId, email])
}

model PushDevice {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  token String @unique
  platform String
  sessionTokenHash String?
  sessionVersion Int
  sessionExpiresAt DateTime
  updatedAt DateTime @updatedAt
  deliveries PushDelivery[]
  @@index([userId])
}

model PushDelivery {
  id String @id @default(cuid())
  deviceId String
  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  messageId String
  recipientId String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  receiptId String?
  createdAt DateTime @default(now())
  @@unique([deviceId, messageId])
  @@index([status, nextAttemptAt])
}

model ProspectProfile {
  id                               String              @id @default(cuid())
  userId                           String              @unique
  companyName                      String
  signupDate                       DateTime            @default(now())
  assignedSalesManagerId           String
  certificationStatus              CertificationStatus @default(ONBOARDING)
  marketingConsultationDueAt       DateTime
  marketingConsultationCompletedAt DateTime?
  jbWarrantiesDueAt                DateTime
  jbWarrantiesCompletedAt          DateTime?
  createdAt                        DateTime            @default(now())
  updatedAt                        DateTime            @updatedAt

  user                 User @relation("ProspectUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedSalesManager User @relation("AssignedSalesManager", fields: [assignedSalesManagerId], references: [id])
}

model SalesManagerProfile {
  availabilityTimezone String?
  availabilityHours Json?
  availabilityMode String @default("SCHEDULE")
  availabilityOverrideUntil DateTime?
  silenceWhenUnavailable Boolean @default(false)
  outOfOfficeMessage String?
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("SalesManagerUser", fields: [userId], references: [id], onDelete: Cascade)
}

model InitialTrainingVerification {
  developmentOnly Boolean @default(false)
  id String @id @default(cuid())
  prospectUserId String @unique
  verifiedByUserId String?
  completedAt DateTime
  verifiedAt DateTime @default(now())
  source String
  reference String
  enrollmentId String?
  prospect User @relation("TrainingProspect", fields: [prospectUserId], references: [id], onDelete: Cascade)
  verifier User? @relation("TrainingVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
}

model RegistrationInvite {
  id                     String           @id @default(cuid())
  token                  String           @unique
  recipientEmail         String?
  roleToCreate           InviteStatusRole @default(PROSPECT)
  assignedSalesManagerId String
  expiresAt              DateTime
  usedAt                 DateTime?
  createdAt              DateTime         @default(now())

  @@index([recipientEmail])
}

model ClassSession {
  id          String             @id @default(cuid())
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime
  virtualUrl  String             @unique
  status      ClassSessionStatus @default(SCHEDULED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  enrollments ClassEnrollment[]
}

model ClassEnrollment {
  id             String                @id @default(cuid())
  classSessionId String
  prospectUserId String
  status         ClassEnrollmentStatus @default(ENROLLED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  prospect     User         @relation(fields: [prospectUserId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, prospectUserId])
}

model EquipmentRegistration {
  id             String                      @id @default(cuid())
  prospectUserId String
  equipmentName  String
  modelNumber    String
  serialNumber   String                      @unique
  status         EquipmentRegistrationStatus @default(SUBMITTED)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  prospect User @relation(fields: [prospectUserId], references: [id], onDelete: Cascade)
}

model Resource {
  id           String       @id @default(cuid())
  title        String
  description  String
  resourceType ResourceType
  url          String       @unique
  category     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model TodoItem {
  id             String         @id @default(cuid())
  prospectUserId String
  title          String
  description    String
  type           TodoItemType
  dueAt          DateTime
  completedAt    DateTime?
  status         TodoItemStatus @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  prospect User @relation(fields: [prospectUserId], references: [id], onDelete: Cascade)

  @@unique([prospectUserId, type])
}

model Benefit {
  id          String      @id @default(cuid())
  title       String
  description String
  benefitType BenefitType
  url         String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model MarketingConsultation {
  id                       String                    @id @default(cuid())
  prospectUserId           String                    @unique
  availabilityOptionOne    String?
  availabilityOptionTwo    String?
  availabilityOptionThree  String?
  externalSubmissionStatus MarketingSubmissionStatus @default(NOT_SUBMITTED)
  submittedAt              DateTime?
  completedAt              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  prospect User @relation(fields: [prospectUserId], references: [id], onDelete: Cascade)
}

model LeadRecord {
  id                     String           @id @default(cuid())
  prospectUserId         String           @unique
  assignedSalesManagerId String
  status                 LeadRecordStatus @default(NEW)
  notes                  String?
  externalLeadId         String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  prospect             User @relation("LeadProspect", fields: [prospectUserId], references: [id], onDelete: Cascade)
  assignedSalesManager User @relation("LeadManager", fields: [assignedSalesManagerId], references: [id])
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(PROSPECT_MANAGER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime?

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String    @id @default(cuid())
  conversationId  String
  senderId        String
  body            String
  clientMessageId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports      MessageReport[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model AccountDeletionRequest {
  id          String                       @id @default(cuid())
  userId      String?
  email       String
  role        UserRole?
  source      AccountDeletionRequestSource
  status      AccountDeletionRequestStatus @default(PENDING_VERIFICATION)
  requestedAt DateTime                     @default(now())
  verifiedAt  DateTime?
  verifiedBy  String?
  completedAt DateTime?

  @@index([status, requestedAt])
  @@index([email, requestedAt])
}

model MessageReport {
  id           String              @id @default(cuid())
  messageId    String
  reporterId   String
  reason       String?
  status       MessageReportStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  resolvedAt   DateTime?
  resolution   String?
  resolutionBy String?

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User    @relation("MessageReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@index([status, createdAt])
}

model UserBlock {
  blockerId     String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker     User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedUserId])
  @@index([blockedUserId])
}

model JotformSubmission {
  id                     String            @id @default(cuid())
  formId                 String
  submissionId           String
  lastEnqueuedBy         JotformSyncSource
  syncStatus             JotformSyncStatus @default(PENDING)
  generation             Int               @default(1)
  processingGeneration   Int?
  attemptCount           Int               @default(0)
  nextAttemptAt          DateTime          @default(now())
  leaseToken             String?
  leaseExpiresAt         DateTime?
  firstWebhookReceivedAt DateTime?
  lastWebhookReceivedAt  DateTime?
  webhookDeliveryCount   Int               @default(0)
  envelopeFingerprint    String?
  vendorCreatedAt        String?
  vendorUpdatedAt        String?
  vendorStatus           String?
  workflowStatus         String?
  contentHash            String?
  ownerUserId            String?
  owner                  User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownershipVerifiedAt    DateTime?
  ownershipVerifiedBy    String?
  respondentEmail        String?
  companyName            String?
  dealerNumber           String?
  reviewReasonCode       String?
  privacyErasedAt        DateTime?
  lastVerifiedAt         DateTime?
  lastAttemptAt          DateTime?
  processedAt            DateTime?
  deadLetteredAt         DateTime?
  lastErrorCode          String?
  lastErrorHttpStatus    Int?
  lastErrorRetryable     Boolean?
  lastErrorAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([formId, submissionId])
  @@index([syncStatus, nextAttemptAt])
  @@index([formId, vendorUpdatedAt, submissionId])
  @@index([respondentEmail])
  @@index([ownerUserId])
}

model JotformSyncState {
  formId                      String    @id
  watermark                   String?
  reconciliationFrom          String?
  reconciliationOffset        Int       @default(0)
  reconciliationHighWatermark String?
  reconciliationAfterId       String?
  lastAttemptAt               DateTime?
  lastSuccessfulAt            DateTime?
  consecutiveFailures         Int       @default(0)
  leaseToken                  String?
  leaseExpiresAt              DateTime?
  lastErrorCode               String?
  apiLimitRemaining           Int?
  apiLimitResetAt             DateTime?
  apiCircuitOpenUntil         DateTime?
  apiCircuitReason            String?
  apiLeaseToken               String?
  apiLeaseExpiresAt           DateTime?
  lastOperationalAlertAt      DateTime?
  lastOperationalAlertHash    String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}


// Only hashes are stored; expired rows can be safely pruned.
model RevokedSession {
  tokenHash String @id
  expiresAt DateTime
  @@index([expiresAt])
}
